{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@twinforge/shared": ["../../packages/shared/src/types.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
